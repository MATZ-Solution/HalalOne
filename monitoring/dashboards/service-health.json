{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "The Loki datasource holding halalify-backend logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Is the app up, fast and error-free? Sections 2, 3 and 4 of the Dashboard Metrics Reference.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["halalone", "logs", "service-health"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "HalalOne - Service Health",
  "uid": "halalone-service-health",
  "version": 2,
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## Service Health\nIs the app working, and is it fast? **Read the four boxes below first** - if they are green, nothing is wrong.\n\n`Requests` how many things the app did &nbsp;·&nbsp; `Success ratio` how many worked &nbsp;·&nbsp; `Error rate` how many broke &nbsp;·&nbsp; `p95 latency` 95 out of 100 requests were faster than this.\n\nAn empty error chart is **good news** - it means nothing failed. Change the time window with the picker at the top right."
      }
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Requests handled",
      "description": "How many requests the backend completed in the selected time window. The small graph shows when they happened.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto", "orientation": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "range",
          "legendFormat": "requests",
          "expr": "sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=`process.end` [$__interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Success ratio",
      "description": "Percentage of requests that finished successfully. Green above 99%, amber 95-99%, red below 95%.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 1, "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "expr": "100 * ((sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\", status=\"status\" | event=`process.end` | status=`success` [$__range])) or vector(0)) / sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=`process.end` [$__range])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "description": "Percentage of requests that failed. 0% is what you want to see.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 2, "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "expr": "100 * ((sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\", status=\"status\" | event=`process.end` | status=`error` [$__range])) or vector(0)) / sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=`process.end` [$__range])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 response time",
      "description": "95 out of every 100 requests finished faster than this. Chat prompts run the whole AI agent, so several seconds is normal.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 3 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 8000 },
              { "color": "red", "value": 15000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "expr": "quantile_over_time(0.95, {job=\"halalify-backend\"} | json event=\"event\", duration_ms=\"duration_ms\" | event=`process.end` | unwrap duration_ms [$__range]) by (job)"
        }
      ]
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "Activity over time",
      "description": "When the app was busy. One line, so there are no colours to decode - height means busier.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 18, "showPoints": "auto",
            "pointSize": 6, "spanNulls": false, "gradientMode": "opacity",
            "axisGridShow": true, "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "range",
          "legendFormat": "requests",
          "expr": "sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=`process.end` [$__interval]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Which features are used most",
      "description": "Requests per endpoint over the selected window. Longer bar = used more. ws.prompt is a chat message, ws.image an uploaded photo.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "text",
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 16,
        "namePlacement": "left",
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{action}}",
          "expr": "sum by (action) (count_over_time({job=\"halalify-backend\"} | json event=\"event\", action=\"action\" | event=`process.end` [$__range]))"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Failures over time",
      "description": "When requests failed. EMPTY IS GOOD - a flat empty chart means nothing broke.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0, "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "barWidthFactor": 0.8, "barAlignment": 0 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "range",
          "legendFormat": "failures",
          "expr": "sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\", status=\"status\" | event=`process.end` | status=`error` [$__interval]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "What went wrong",
      "description": "Failures grouped by the kind of error. Empty means no failures in this window.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "valueMode": "text",
        "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 16, "namePlacement": "left", "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{error_type}}",
          "expr": "sum by (error_type) (count_over_time({job=\"halalify-backend\"} | json event=\"event\", status=\"status\", error_type=\"error_type\" | event=`process.end` | status=`error` [$__range]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Where it went wrong",
      "description": "Failures grouped by endpoint - tells you which feature is broken, not just that something is.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "valueMode": "text",
        "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 16, "namePlacement": "left", "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{action}}",
          "expr": "sum by (action) (count_over_time({job=\"halalify-backend\"} | json event=\"event\", status=\"status\", action=\"action\" | event=`process.end` | status=`error` [$__range]))"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Response time trend",
      "description": "Three shades of one colour, light to dark: typical (p50), slow (p95), worst (p99). A widening gap between them means the experience is getting uneven.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "auto", "pointSize": 6, "spanNulls": true, "lineInterpolation": "smooth" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "typical (p50)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "super-light-blue" } }] },
          { "matcher": { "id": "byName", "options": "slow (p95)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "worst (p99)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-blue" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "range",
          "legendFormat": "typical (p50)",
          "expr": "quantile_over_time(0.50, {job=\"halalify-backend\"} | json event=\"event\", duration_ms=\"duration_ms\" | event=`process.end` | unwrap duration_ms [$__interval]) by (job)"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "range",
          "legendFormat": "slow (p95)",
          "expr": "quantile_over_time(0.95, {job=\"halalify-backend\"} | json event=\"event\", duration_ms=\"duration_ms\" | event=`process.end` | unwrap duration_ms [$__interval]) by (job)"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "range",
          "legendFormat": "worst (p99)",
          "expr": "quantile_over_time(0.99, {job=\"halalify-backend\"} | json event=\"event\", duration_ms=\"duration_ms\" | event=`process.end` | unwrap duration_ms [$__interval]) by (job)"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Slowest features (p95)",
      "description": "Response time per endpoint. Longer bar = slower. Amber past 8 seconds, red past 15.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "valueMode": "text",
        "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 16, "namePlacement": "left", "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 0, "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 8000 }, { "color": "red", "value": 15000 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{action}}",
          "expr": "quantile_over_time(0.95, {job=\"halalify-backend\"} | json event=\"event\", action=\"action\", duration_ms=\"duration_ms\" | event=`process.end` | unwrap duration_ms [$__range]) by (action)"
        }
      ]
    }
  ]
}
