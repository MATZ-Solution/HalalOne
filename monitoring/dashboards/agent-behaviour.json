{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "The Loki datasource holding halalify-backend logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "text", "name": "Text", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "What the AI agent is doing - which search tools it picks, whether they find anything, and where it fails. Sections 7 and 8 of the Dashboard Metrics Reference.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["halalone", "logs", "agent"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "HalalOne - Agent Behaviour",
  "uid": "halalone-agent-behaviour",
  "version": 2,
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## Agent Behaviour\nWhen a user asks a question, the AI agent picks a search tool to answer it. This dashboard shows **which tool it picks and whether that tool finds anything**.\n\n`KeywordFilterSearch` exact matching on the product database &nbsp;·&nbsp; `SemanticFilterSearch` meaning-based search for vague questions &nbsp;·&nbsp; `WebSearch` last resort when the database has nothing.\n\n**Heavy WebSearch use is a signal** - it means the product catalogue is not answering the questions people ask. All four boxes below should stay at zero."
      }
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Searches run",
      "description": "How many times the agent used a search tool.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto", "orientation": "auto", "justifyMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" }, "noValue": "0" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "range",
          "legendFormat": "searches",
          "expr": "sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=`tool.invoked` [$__interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agent crashes",
      "description": "A step in the agent raised an error and hit the recovery path. Should be 0.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0, "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=`agent.node.failed` [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model refused to search",
      "description": "The AI declined to call a search tool when it was required. Usually means the prompt confused it. Should be 0.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0, "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=`search_node.declined_tool` [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Photo reading failures",
      "description": "The vision model failed to read an uploaded product label. Should be 0.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background_solid", "graphMode": "none", "textMode": "auto", "orientation": "auto", "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0, "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "expr": "sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=~`vision_llm\\..*` [$__range])) or vector(0)"
        }
      ]
    },

    {
      "id": 5,
      "type": "bargauge",
      "title": "Which search tool the agent chose",
      "description": "Longer bar = used more often. A large WebSearch bar means the product database is not answering people's questions.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "valueMode": "text",
        "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 18, "namePlacement": "left", "sizing": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{tool}}",
          "expr": "sum by (tool) (count_over_time({job=\"halalify-backend\"} | json event=\"event\", tool=\"tool\" | event=`tool.invoked` [$__range]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Average products found per search",
      "description": "How many rows each tool returns on average. A tool near zero is running but finding nothing - that is a search-quality problem, not a crash.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "valueMode": "text",
        "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 18, "namePlacement": "left", "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1, "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 3 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{tool}}",
          "expr": "avg_over_time({job=\"halalify-backend\"} | json event=\"event\", tool=\"tool\", results=\"results\" | event=`tool.invoked` | unwrap results [$__range]) by (tool)"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Search activity over time",
      "description": "When the agent was searching. One line - height means busier.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0, "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 18, "showPoints": "auto", "pointSize": 6, "gradientMode": "opacity", "lineInterpolation": "smooth", "spanNulls": false }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom", "showLegend": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "range",
          "legendFormat": "searches",
          "expr": "sum(count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=`tool.invoked` [$__interval]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Searches that found nothing",
      "description": "Tool calls that returned zero products. High numbers here point at gaps in the catalogue or at queries the search cannot handle.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "valueMode": "text",
        "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 18, "namePlacement": "left", "sizing": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{tool}}",
          "expr": "sum by (tool) (count_over_time({job=\"halalify-backend\"} | json event=\"event\", tool=\"tool\", results=\"results\" | event=`tool.invoked` | results = 0 [$__range]))"
        }
      ]
    },

    {
      "id": 9,
      "type": "bargauge",
      "title": "Agent problems by type",
      "description": "Everything that went wrong inside the agent - node crashes, judge failures, tool failures and web-search retries. Empty is the good case.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "valueMode": "text",
        "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 14, "namePlacement": "left", "sizing": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{event}}",
          "expr": "sum by (event) (count_over_time({job=\"halalify-backend\"} | json event=\"event\" | event=~`agent\\.node\\.failed|judge\\..*|tool\\.(semantic_search|web_search)\\.failed|web_search\\.exa_stream\\..*|vision_llm\\..*` [$__range]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Photo uploads by route",
      "description": "How product photos reach the vision model - the HTTP endpoint or a WebSocket image message.",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal", "displayMode": "basic", "valueMode": "text",
        "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 18, "namePlacement": "left", "sizing": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "queryType": "instant",
          "legendFormat": "{{action}}",
          "expr": "sum by (action) (count_over_time({job=\"halalify-backend\"} | json event=\"event\", action=\"action\" | event=`process.end` | action=~`http\\.extract_image|ws\\.image` [$__range]))"
        }
      ]
    }
  ]
}
