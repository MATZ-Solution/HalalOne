GROQ_API_KEY=
FRONTEND_URL=
FIREWORKS_AI_API_KEY=

# Conversation summarization / compaction
# Base token count that triggers a compaction prompt. The effective trigger is
# this value x (1 + declines) capped at 3x; after the 3rd decline it is forced.
SUMMARY_TOKEN_THRESHOLD=3000
# Number of most-recent turns (user+assistant pairs) kept verbatim after a fold.
SUMMARY_KEEP_TURNS=10
